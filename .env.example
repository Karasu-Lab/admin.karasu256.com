# URL of auth.karasu256.com, which hosts the sign-in page
AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth)
AUTH_API_URL=

# Full origin URL of the main karasu256.com app (e.g. https://karasu256.com
# in production, http://localhost:3000 in local dev), used verbatim as the
# settings link destination in the header's account menu (this app has no
# settings page of its own). Required — requests fail if unset.
ROOT_APP_URL=

# This app's own public URL, used as the `next` redirect target after sign-out.
APP_URL=

# Base URL of the api.admin.karasu256.com NestJS backend. Server-only —
# the browser talks to this app's own /api/* routes, which next.config.ts
# rewrites (proxies) to this URL, including EventSource/SSE connections.
# Required — next.config.ts fails to load if unset.
API_URL=

# Base URL of git.karasu256.com, the internal git service that creates the
# mirror bucket, keeps repository mirrors and creates signed commits.
GIT_API_URL=

# Shared secret for the signed internal API calls to api-auth and to
# git.karasu256.com.
INTERNAL_API_SECRET=

# Master secret of the GitHub App webhook. The app's single webhook
# registration uses this secret, and deliveries signed with it are
# routed to their tenant. Per-tenant webhook secrets are kept in this
# app's D1 database instead and are never registered with the app.
GH_APP_WEBHOOK_SECRET=

# Secret of better-auth on api-auth.karasu256.com, used to encrypt the
# per-tenant webhook secrets stored in this app's D1 database.
BETTER_AUTH_SECRET=
